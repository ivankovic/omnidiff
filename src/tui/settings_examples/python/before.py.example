from collections import namedtuple


def make_book(name, writer, count):
    return dict(
        title=name,
        author=writer,
        pages=count
    )


class Shelf:
    def __init__(self, name, books):
        self.name = name
        self.books = books

    def page_count(self):
        return sum(book["pages"] for book in self.books)

    def describe(self, unit):
        total = self.page_count()
        return f"{self.name}: {total} {unit} to read"


def main():
    sizes = (120, 340)
    dune = make_book("Dune", "Herbert", sizes[0])
    odes = make_book("Odes", "Keats", sizes[1])
    shelves = [
        Shelf("novels", [dune]),
        Shelf("poetry", [odes]),
    ]
    for shelf in shelves:
        print(shelf.describe("pages"))
    longest = max(s.page_count() for s in shelves)
    print(longest)


if __name__ == "__main__":
    main()
