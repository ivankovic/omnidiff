#include <stdio.h>
#include <stdlib.h>

struct fields *make_person(const char *name, int age)
{
    return pack(
        "name", name,
        "age", age
    );
}

struct rect { int width, height; };

static int area(const struct rect *r)
{
    return r->width * r->height;
}

static void describe(const struct rect *r,
                     const char *label)
{
    int total = area(r);
    printf("%s: %d square units\n", label, total);
}

int main(void)
{
    int width = 3, height = 4;
    struct rect shapes[] = {
        {width, height},
        {5, 2},
        {0, 0},
    };
    for (int i = 0; shapes[i].width; i++)
        describe(&shapes[i], "box");
    int first = area(&shapes[0]);
    printf("%d\n", first);
}
