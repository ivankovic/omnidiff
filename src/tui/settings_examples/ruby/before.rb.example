require "date"
require "ostruct"

def build_order(name, total, date)
  OpenStruct.new(
    customer: name,
    amount: total,
    due: date
  )
end

class Ledger
  attr_reader :owner, :entries

  def initialize(owner, entries)
    @owner = owner
    @entries = entries
  end

  def balance
    entries.sum
  end

  def report(currency)
    total = balance
    "#{owner}: #{total} #{currency} still owed"
  end
end

def print_reports
  limits = [40, 15]
  ledgers = [
    Ledger.new("Ana", limits),
    Ledger.new("Ivo", [7, 3]),
  ]
  ledgers.each do |ledger|
    puts ledger.report("EUR")
  end
  richest = ledgers.max_by(&:balance)
  puts richest.owner
end

print_reports
