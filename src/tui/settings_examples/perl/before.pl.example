#!/usr/bin/perl
use strict;
use warnings;

sub label {
    my ($track) = @_;
    return 'Track: ' . $track->{title};
}

sub total_length {
    my (@tracks) = @_;
    my $sum = 0;
    $sum += $_->{seconds} for @tracks;
    return $sum;
}

sub describe {
    my ($name, @tracks) = @_;
    my $total = total_length(@tracks);
    return "$name: $total seconds of music";
}

my @lengths = (180, 240);
my @album = (
    { title => 'Intro', seconds => $lengths[0] },
    { title => 'Rain', seconds => $lengths[1] },
);
foreach my $track (@album) {
    print "$track->{title}\n";
}
print describe('Demo', @album), "\n";
print label($album[0]), "\n";
my $longest = (sort { $b <=> $a } @lengths)[0];
print "$longest\n";
