.card {
  display: flex;
  flex-direction: column;
  padding: 16px;
  border: 1px solid #d0d4da;
  border-radius: 6px;
  background: linear-gradient(
    to bottom,
    #ffffff,
    #f4f6f8
  );
  font-family: Inter, Arial, sans-serif;
}

.card h2 {
  margin: 0 0 8px;
  font-size: 1.25rem;
  font-weight: bold;
}

.card-body {
  color: #444;
  line-height: 1.5;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
}

.card:hover {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}
