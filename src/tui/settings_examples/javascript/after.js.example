import { readFile } from "node:fs/promises";
import path from "node:path";

const Item = (name, count) => ({ name, count });

function makeItem(name, count) {
  return Item(name, count);
}

class Shelf {
  constructor(width, depth) {
    this.width = width;
    this.depth = depth;
  }

  area() {
    return this.width * this.depth;
  }

  perimeter() {
    return 2 * (this.width + this.depth);
  }

  describe(label) {
    const totalArea = this.area();
    return `${label}: ${totalArea} square metres`;
  }
}

function main() {
  const size = [3, 4];
  const shelves = [
    new Shelf(1, 1),
    new Shelf(size[0], size[1]),
    new Shelf(5, 2),
  ];
  if (process.env.DEBUG) {
    for (const shelf of shelves) {
      console.log(shelf.describe("rack"));
    }
  }
  let biggest = shelves.map((s) => s.area());
  console.log(shelves.length, biggest);
}
