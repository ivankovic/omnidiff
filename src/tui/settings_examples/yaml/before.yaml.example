name: build
on:
  push:
    branches: [main, dev]
  pull_request:

defaults: &defaults
  runs-on: ubuntu-latest
  timeout: 20

jobs:
  test:
    <<: *defaults
    strategy:
      node: [
        16, 18,
        20
      ]
      os: [ubuntu-latest, macos-latest]
    steps:
      - uses: actions/checkout@v3
      - name: Install
        run: npm ci
      - name: Test
        run: npm test -- --coverage
  docs:
    <<: *defaults
    steps:
      - uses: actions/checkout@v3
      - run: npm run docs
