# The image scripts/showcase_shots/run.py takes the README's pictures in: Playwright's own image,
# which carries the Chromium its version was tested with, the Playwright package for Node at that
# same version, and DejaVu Sans Mono. The font is why this is an image of its own: the base image's
# only monospace faces draw box characters from a second font at another width, and the pictures
# would then depend on which fonts a machine happens to have.
ARG PLAYWRIGHT_VERSION=1.65.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble
ARG PLAYWRIGHT_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f

RUN mkdir -p /opt/playwright && cd /opt/playwright \
    && npm init -y >/dev/null \
    && npm install --no-audit --no-fund "playwright@${PLAYWRIGHT_VERSION}"
ENV NODE_PATH=/opt/playwright/node_modules
